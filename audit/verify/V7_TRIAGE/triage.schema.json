{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/ai-risk-snapshot/triage.schema.json",
  "title": "AI risk snapshot triage file",
  "description": "An overlay over report.json. The key is the SARIF fingerprint aiRiskSnapshot/v1. Human fields are preserved across re-scans.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "fingerprintScheme", "findings"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "generatedBy": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "tool": { "type": ["string", "null"] },
    "reportVersion": { "type": ["string", "null"] },
    "lastReportGeneratedAt": { "type": ["string", "null"], "format": "date-time" },
    "reportSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rulePackSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "fingerprintScheme": { "const": "sarif:aiRiskSnapshot/v1" },
    "summary": {
      "type": "object",
      "required": ["total", "presentInLatest", "notSeenInLatest", "byStatus"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "presentInLatest": { "type": "integer", "minimum": 0 },
        "notSeenInLatest": { "type": "integer", "minimum": 0 },
        "byStatus": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/definitions/finding" }
    }
  },
  "definitions": {
    "status": {
      "enum": [
        "unreviewed",
        "true_positive",
        "false_positive",
        "context",
        "accepted_risk",
        "fixed",
        "wont_fix",
        "duplicate"
      ]
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "ruleId",
        "file",
        "line",
        "severity",
        "status",
        "owner",
        "notes",
        "firstSeen",
        "lastSeen",
        "seenCount",
        "notSeenInLatest"
      ],
      "properties": {
        "fingerprint": { "$ref": "#/definitions/fingerprint" },
        "ruleId": { "type": "string", "minLength": 1 },
        "file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\\\]+$",
          "description": "Forward slashes only; no backslashes."
        },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "lineRaw": { "type": ["integer", "string", "null"] },
        "severity": { "type": ["string", "null"] },
        "article": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] },
        "confidence": { "type": ["string", "null"] },
        "method": { "type": ["string", "null"] },
        "toolExposure": { "type": ["string", "null"] },
        "snippet": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "owner": { "type": ["string", "null"] },
        "notes": { "type": "string" },
        "labels": { "type": "array", "items": { "type": "string" } },
        "duplicateOf": {
          "oneOf": [{ "$ref": "#/definitions/fingerprint" }, { "type": "null" }]
        },
        "acceptedRiskExpiry": { "type": ["string", "null"], "format": "date" },
        "firstSeen": { "type": "string", "format": "date-time" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "seenCount": { "type": "integer", "minimum": 1 },
        "notSeenInLatest": { "type": "boolean" },
        "verification": {
          "oneOf": [{ "$ref": "#/definitions/verification" }, { "type": "null" }]
        },
        "history": { "type": "array", "items": { "$ref": "#/definitions/historyEntry" } }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citationVerified", "lineStatus", "snippetStatus"],
      "properties": {
        "citationVerified": { "type": "boolean" },
        "lineStatus": { "type": "string" },
        "snippetStatus": { "type": "string" },
        "snippetFoundAtLine": { "type": ["integer", "null"] },
        "fingerprint": { "$ref": "#/definitions/fingerprint" }
      }
    },
    "historyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reportSha256", "present"],
      "properties": {
        "reportSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reportGeneratedAt": { "type": ["string", "null"], "format": "date-time" },
        "present": { "type": "boolean" }
      }
    }
  }
}
